{
  "name": "solomatch-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-solomatch \"node --test --test-concurrency=1 test/rules/\"",
    "test:functions": "npm run build && firebase emulators:exec --only firestore --project demo-solomatch \"node --test --test-concurrency=1 test/functions/\"",
    "test": "npm run test:functions && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.4",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}

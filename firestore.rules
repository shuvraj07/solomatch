rules_version = '2';

// Security model: see docs/firestore-schema.md. Everything not matched below
// is denied. Every rule here has tests in functions/test/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return incoming().diff(resource.data).affectedKeys();
    }

    // ---------- players (public football profile) ----------

    function positions() {
      return ['goalkeeper', 'centerBack', 'fullBack', 'defensiveMidfielder',
              'centralMidfielder', 'attackingMidfielder', 'winger', 'striker'];
    }

    // Fields a player may write. `stats` is server-only; `username` is set
    // once at creation together with its `usernames/` claim.
    function editableProfileKeys() {
      return ['fullName', 'searchName', 'photoUrl', 'dateOfBirth', 'city',
              'bio', 'primaryPosition', 'secondaryPositions', 'skillLevel',
              'preferredFoot', 'heightCm', 'yearsPlaying', 'languages',
              'availability', 'privacy', 'updatedAt'];
    }

    function validProfile(d) {
      return d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 60
        && d.searchName == d.fullName.lower()
        && (d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 1024))
        // 16+ (5840 days; the app does the exact calendar check).
        && d.dateOfBirth is timestamp
        && d.dateOfBirth < request.time - duration.value(5840, 'd')
        && d.city is string && d.city.size() >= 1 && d.city.size() <= 60
        && d.bio is string && d.bio.size() <= 300
        && d.primaryPosition in positions()
        && d.secondaryPositions is list && d.secondaryPositions.size() <= 3
        && d.secondaryPositions.hasOnly(positions())
        && d.skillLevel in ['beginner', 'intermediate', 'advanced']
        && d.preferredFoot in ['right', 'left', 'both']
        && (d.heightCm == null || (d.heightCm is int && d.heightCm >= 120 && d.heightCm <= 230))
        && d.yearsPlaying is int && d.yearsPlaying >= 0 && d.yearsPlaying <= 60
        && d.languages is list && d.languages.size() <= 10
        && d.availability is list && d.availability.size() <= 21
        && (!('privacy' in d)
            || (d.privacy.keys().hasOnly(['hideCity']) && d.privacy.hideCity is bool))
        && d.updatedAt == request.time;
    }

    match /players/{uid} {
      allow read: if signedIn();

      allow create: if isUser(uid)
        && incoming().keys().hasOnly(editableProfileKeys().concat(['username', 'createdAt']))
        && validProfile(incoming())
        && incoming().createdAt == request.time
        // An account is either a player or a venue owner.
        && !exists(/databases/$(database)/documents/owners/$(uid))
        // The username claim must be written in the same transaction.
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == uid;

      allow update: if isUser(uid)
        && changedKeys().hasOnly(editableProfileKeys())
        && validProfile(incoming());

      allow delete: if false;
    }

    // ---------- usernames (uniqueness index) ----------

    match /usernames/{username} {
      // `get` lets onboarding check availability; listing is not allowed.
      allow get: if signedIn();
      allow list: if false;

      // Only while creating your profile (so one username per player).
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid == request.auth.uid
        && !exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username == username;

      allow update, delete: if false;
    }

    // ---------- matches ----------

    function matchFormats() {
      return ['fiveASide', 'sevenASide', 'nineASide', 'elevenASide'];
    }

    function slotGroups() {
      return ['gk', 'def', 'mid', 'fwd', 'any'];
    }

    function openSlot(s, max) {
      return s.keys().hasOnly(['needed', 'filled'])
        && s.needed is int && s.needed >= 0 && s.needed <= max
        && s.filled == 0;
    }

    // New match: nothing filled, groups add up exactly to maxPlayers.
    function validNewSlots(s, max) {
      return s.keys().hasOnly(slotGroups()) && s.keys().hasAll(slotGroups())
        && openSlot(s.gk, max) && openSlot(s.def, max) && openSlot(s.mid, max)
        && openSlot(s.fwd, max) && openSlot(s.any, max)
        && s.gk.needed + s.def.needed + s.mid.needed + s.fwd.needed + s.any.needed == max;
    }

    function validVenue(v) {
      return v.keys().hasOnly(['name', 'address', 'city', 'placeId', 'lat', 'lng'])
        && v.name is string && v.name.size() >= 1 && v.name.size() <= 80
        && v.address is string && v.address.size() <= 120
        && v.city is string && v.city.size() >= 1 && v.city.size() <= 60
        && (v.placeId == null || v.placeId is string)
        && (v.lat == null || (v.lat is number && v.lat >= -90 && v.lat <= 90))
        && (v.lng == null || (v.lng is number && v.lng >= -180 && v.lng <= 180));
    }

    function validMatchText(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.searchTitle == d.title.lower()
        && d.description is string && d.description.size() <= 1000
        && d.rules is string && d.rules.size() <= 1000
        && d.photos is list && d.photos.size() <= 5;
    }

    function validPrice(p) {
      return p.keys().hasOnly(['amount', 'currency', 'isFree'])
        && p.amount is int && p.amount >= 0 && p.amount <= 100000
        && p.currency == 'NPR'
        && p.isFree == (p.amount == 0);
    }

    function validTeams(t) {
      return t.keys().hasOnly(['home', 'away']) && t.keys().hasAll(['home', 'away'])
        && t.home is string && t.home.size() >= 1 && t.home.size() <= 30
        && t.away is string && t.away.size() >= 1 && t.away.size() <= 30;
    }

    function isMatchOrganizer() {
      return signedIn() && resource.data.organizer.uid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      // Publishing. Counters start at zero; after this only the server
      // (Cloud Functions) changes roster counts and status, except cancel.
      allow create: if signedIn()
        && incoming().keys().hasOnly([
             'organizer', 'title', 'searchTitle', 'venue', 'startAt', 'endAt',
             'format', 'maxPlayers', 'currentPlayers', 'spotsRemaining', 'slots',
             'skillLevel', 'price', 'isIndoor', 'description', 'rules', 'photos',
             'status', 'createdAt', 'updatedAt'])
        && incoming().organizer.keys().hasOnly(['uid', 'name', 'username', 'photoUrl'])
        && incoming().organizer.uid == request.auth.uid
        && incoming().organizer.username
             == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.username
        && validMatchText(incoming())
        && validVenue(incoming().venue)
        && incoming().startAt is timestamp && incoming().startAt > request.time
        && incoming().endAt is timestamp
        && incoming().endAt >= incoming().startAt + duration.value(30, 'm')
        && incoming().endAt <= incoming().startAt + duration.value(6, 'h')
        && incoming().format in matchFormats()
        && incoming().maxPlayers is int
        && incoming().maxPlayers >= 2 && incoming().maxPlayers <= 30
        && incoming().currentPlayers == 0
        && incoming().spotsRemaining == incoming().maxPlayers
        && validNewSlots(incoming().slots, incoming().maxPlayers)
        && incoming().skillLevel in ['beginner', 'intermediate', 'advanced', 'any']
        && validPrice(incoming().price)
        && incoming().isIndoor is bool
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isMatchOrganizer()
        && incoming().updatedAt == request.time
        && (
          // Edit descriptive fields.
          (changedKeys().hasOnly(['title', 'searchTitle', 'description', 'rules',
                                  'photos', 'updatedAt'])
            && validMatchText(incoming()))
          ||
          // Team names for the live match center.
          (changedKeys().hasOnly(['teams', 'updatedAt'])
            && validTeams(incoming().teams)
            && resource.data.status != 'cancelled')
          ||
          // Cancel before kick-off.
          (changedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'cancelled'
            && resource.data.status in ['published', 'filling', 'full'])
        );

      allow delete: if false;

      function thisMatch() {
        return get(/databases/$(database)/documents/matches/$(matchId)).data;
      }

      // ----- join requests: matches/{matchId}/requests/{playerId} -----
      // Doc ID = player uid, so one request per player per match.
      // Accept / reject / leave happen only in Cloud Functions.

      function playerDoc() {
        return get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
      }

      // The player card organizers see must match the real profile.
      function validPlayerCard(p) {
        let profile = playerDoc();
        let stats = profile.get('stats', {});
        return p.keys().hasOnly(['uid', 'name', 'username', 'photoUrl',
                                 'primaryPosition', 'secondaryPositions',
                                 'skillLevel', 'ratingAvg', 'ratingCount',
                                 'gamesPlayed'])
          && p.uid == request.auth.uid
          && p.name == profile.fullName
          && p.username == profile.username
          && p.photoUrl == profile.photoUrl
          && p.primaryPosition == profile.primaryPosition
          && p.secondaryPositions == profile.secondaryPositions
          && p.skillLevel == profile.skillLevel
          && p.ratingAvg == stats.get('ratingAvg', 0)
          && p.ratingCount == stats.get('ratingCount', 0)
          && p.gamesPlayed == stats.get('gamesPlayed', 0);
      }

      function validNewRequest() {
        let m = thisMatch();
        return incoming().keys().hasOnly(['status', 'player', 'preferredGroup',
                                          'message', 'match', 'createdAt', 'updatedAt'])
          && incoming().status == 'pending'
          && validPlayerCard(incoming().player)
          && incoming().preferredGroup in slotGroups()
          && incoming().message is string && incoming().message.size() <= 200
          && incoming().match.keys().hasOnly(['title', 'startAt', 'venueName'])
          && incoming().match.title == m.title
          && incoming().match.startAt == m.startAt
          && incoming().match.venueName == m.venue.name
          && m.organizer.uid != request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(m.organizer.uid)/blocks/$(request.auth.uid))
          && m.status in ['published', 'filling']
          && m.startAt > request.time
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
      }

      match /requests/{playerId} {
        allow read: if isUser(playerId)
          || (signedIn() && thisMatch().organizer.uid == request.auth.uid);

        allow create: if isUser(playerId) && validNewRequest();

        allow update: if isUser(playerId) && (
          // Withdraw a pending request.
          (resource.data.status == 'pending'
            && changedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'cancelled'
            && incoming().updatedAt == request.time)
          ||
          // Ask again after withdrawing or leaving. Rejection is final.
          (resource.data.status == 'cancelled' && validNewRequest())
        );

        allow delete: if false;
      }

      // ----- roster: matches/{matchId}/roster/{playerId} (server-only) -----

      match /roster/{playerId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // ----- live match center: matches/{matchId}/events/{eventId} -----
      // Anyone signed in can watch. Only the organizer posts goals and cards,
      // from 10 minutes before kick-off until 3 hours after the final
      // whistle, and can delete (undo) them in that window. The score on
      // the match is recounted by the onMatchEventWritten function.

      function liveWindow() {
        let m = thisMatch();
        return m.organizer.uid == request.auth.uid
          && m.status != 'cancelled'
          && request.time >= m.startAt - duration.value(10, 'm')
          && request.time <= m.endAt + duration.value(3, 'h');
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && liveWindow()
          && incoming().keys().hasOnly(['type', 'team', 'playerUid', 'playerName',
                                        'minute', 'by', 'createdAt'])
          && incoming().type in ['goal', 'yellow', 'red']
          && incoming().team in ['home', 'away']
          && (incoming().playerUid == null || incoming().playerUid is string)
          && incoming().playerName is string && incoming().playerName.size() <= 60
          && incoming().minute is int && incoming().minute >= 0 && incoming().minute <= 200
          && incoming().by == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if signedIn() && liveWindow();
        allow update: if false;
      }

      // ----- followers: matches/{matchId}/followers/{uid} -----
      // Get goal and full-time notifications. The count is kept on the
      // match (followerCount) by a function.

      match /followers/{followerId} {
        allow read, delete: if isUser(followerId);
        allow create: if isUser(followerId)
          && incoming().keys().hasOnly(['createdAt'])
          && incoming().createdAt == request.time;
        allow update: if false;
      }

      // ----- Man of the Match: matches/{matchId}/motm_votes/{voterId} -----
      // One vote per voter (doc ID), changeable until voting closes. Voters
      // are roster players and the organizer; nominees are roster players,
      // never yourself. The server tallies when voting closes.

      function onRoster(uid) {
        return exists(/databases/$(database)/documents/matches/$(matchId)/roster/$(uid));
      }

      match /motm_votes/{voterId} {
        allow read: if isUser(voterId);

        allow create, update: if isUser(voterId)
          && incoming().keys().hasOnly(['nomineeId', 'votedAt'])
          && incoming().votedAt == request.time
          && incoming().nomineeId is string
          && incoming().nomineeId != request.auth.uid
          && onRoster(incoming().nomineeId)
          && (onRoster(request.auth.uid) || thisMatch().organizer.uid == request.auth.uid)
          && thisMatch().status == 'completed'
          && request.time < thisMatch().votingClosesAt;

        allow delete: if false;
      }
    }

    // ---------- "My matches": my requests across all matches ----------
    // Collection-group reads only return a player's own requests. The
    // query must filter on player.uid == my uid for this to pass.
    match /{path=**}/requests/{playerId} {
      allow read: if signedIn() && resource.data.player.uid == request.auth.uid;
    }

    // ---------- chat ----------
    // Conversations are created and their members kept in sync only by
    // Cloud Functions. Members can read, send messages and move their own
    // read marker.

    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isMember();

      // Only your own entry in readAt, and only to "now".
      allow update: if isMember()
        && changedKeys().hasOnly(['readAt'])
        && incoming().readAt.diff(resource.data.readAt).affectedKeys()
             .hasOnly([request.auth.uid])
        && incoming().readAt[request.auth.uid] == request.time;

      allow create, delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function member() {
          return signedIn() && request.auth.uid in conversation().participantIds;
        }

        allow read: if member();

        allow create: if member()
          && incoming().senderId == request.auth.uid
          && incoming().keys().hasOnly(['senderId', 'text', 'imageUrl', 'sentAt'])
          && incoming().sentAt == request.time
          && (
            (incoming().text is string
              && incoming().text.size() >= 1 && incoming().text.size() <= 2000
              && !('imageUrl' in incoming()))
            ||
            (incoming().imageUrl is string && incoming().imageUrl.size() <= 2048
              && !('text' in incoming()))
          );

        allow update, delete: if false;
      }
    }

    // ---------- reviews ----------
    // reviews/{matchId}_{reviewerId}_{revieweeId}: one per pair per match,
    // create-only. Both people must have been at the match (roster or
    // organizer), within 7 days of the final whistle. Ratings are applied
    // to players/{uid}.stats by the onReviewCreated function.

    match /reviews/{reviewId} {
      function reviewedMatch() {
        return get(/databases/$(database)/documents/matches/$(incoming().matchId)).data;
      }

      function wasThere(m, uid) {
        return m.organizer.uid == uid
          || exists(/databases/$(database)/documents/matches/$(incoming().matchId)/roster/$(uid));
      }

      function validReview() {
        let m = reviewedMatch();
        let me = get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
        return incoming().keys().hasOnly(['matchId', 'reviewerId', 'revieweeId', 'rating',
                                          'comment', 'reviewer', 'matchTitle', 'createdAt'])
          && incoming().reviewerId == request.auth.uid
          && incoming().revieweeId is string
          && incoming().revieweeId != request.auth.uid
          && reviewId == incoming().matchId + '_' + request.auth.uid + '_' + incoming().revieweeId
          && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
          && incoming().comment is string && incoming().comment.size() <= 300
          && incoming().reviewer.keys().hasOnly(['name', 'photoUrl'])
          && incoming().reviewer.name == me.fullName
          && incoming().reviewer.photoUrl == me.photoUrl
          && m.status == 'completed'
          && request.time < m.endAt + duration.value(7, 'd')
          && incoming().matchTitle == m.title
          && wasThere(m, request.auth.uid)
          && wasThere(m, incoming().revieweeId)
          && incoming().createdAt == request.time;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validReview();
      allow update, delete: if false;
    }

    // ---------- reports (safety) ----------
    // Anyone signed in can report; only admins (custom claim) can read.

    match /reports/{reportId} {
      allow create: if signedIn()
        && incoming().keys().hasOnly(['reporterId', 'targetType', 'targetId',
                                      'targetName', 'reason', 'details',
                                      'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && incoming().targetType in ['player', 'match']
        && incoming().targetId is string && incoming().targetId.size() <= 128
        && incoming().targetId != request.auth.uid
        && incoming().targetName is string && incoming().targetName.size() <= 120
        && incoming().reason in ['harassment', 'no_show', 'unsafe', 'fake',
                                 'spam', 'inappropriate', 'other']
        && incoming().details is string && incoming().details.size() <= 500
        && incoming().status == 'open'
        && incoming().createdAt == request.time;
      allow read, update: if signedIn() && request.auth.token.admin == true;
      allow delete: if false;
    }

    // ---------- venue owners ----------
    // owners/{uid}: the business contact. An account is either a player or
    // a venue owner. Each owner has one venue: venues/{ownerUid}.

    // existsAfter: setup writes owners/{uid} and venues/{uid} in one batch.
    function isOwner() {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function validPhone(p) {
      return p is string && p.matches('^[+0-9 -]{7,20}$');
    }

    function validOwner(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && validPhone(d.phone);
    }

    match /owners/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && incoming().keys().hasOnly(['name', 'phone', 'createdAt'])
        && validOwner(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/players/$(uid));
      allow update: if isUser(uid)
        && changedKeys().hasOnly(['name', 'phone'])
        && validOwner(incoming());
      allow delete: if false;
    }

    // ---------- venues ----------

    function amenities() {
      return ['parking', 'changing_room', 'showers', 'drinking_water',
              'floodlights', 'cafe', 'bibs', 'balls'];
    }

    function editableVenueKeys() {
      return ['name', 'searchName', 'address', 'city', 'phone', 'description',
              'isIndoor', 'formats', 'pricePerHour', 'amenities', 'photos',
              'lat', 'lng', 'updatedAt'];
    }

    function validVenueProfile(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.searchName == d.name.lower()
        && d.address is string && d.address.size() <= 120
        && d.city is string && d.city.size() >= 1 && d.city.size() <= 60
        && validPhone(d.phone)
        && d.description is string && d.description.size() <= 1000
        && d.isIndoor is bool
        && d.formats is list && d.formats.size() >= 1 && d.formats.hasOnly(matchFormats())
        && d.pricePerHour is int && d.pricePerHour >= 0 && d.pricePerHour <= 100000
        && d.amenities is list && d.amenities.hasOnly(amenities())
        && d.photos is list && d.photos.size() <= 5
        && (d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (d.lng == null || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && d.updatedAt == request.time;
    }

    match /venues/{venueId} {
      allow read: if signedIn();

      // `rating` is server-only (averages from venue ratings).
      allow create: if isUser(venueId)
        && isOwner()
        && incoming().keys().hasOnly(editableVenueKeys().concat(['ownerId', 'createdAt']))
        && incoming().ownerId == venueId
        && incoming().createdAt == request.time
        && validVenueProfile(incoming());
      allow update: if isUser(venueId)
        && changedKeys().hasOnly(editableVenueKeys())
        && validVenueProfile(incoming());
      allow delete: if false;

      // ----- slots: venues/{venueId}/slots/{slotId} -----
      // The owner lists and removes free slots. Booking (free → booked)
      // happens only in publishDraft; cancelling in Cloud Functions.

      function validFreeSlot(d) {
        return d.keys().hasOnly(['startAt', 'endAt', 'price', 'status', 'createdAt'])
          && d.status == 'free'
          && d.startAt is timestamp && d.startAt > request.time
          && d.endAt is timestamp
          && d.endAt >= d.startAt + duration.value(30, 'm')
          && d.endAt <= d.startAt + duration.value(6, 'h')
          && d.price is int && d.price >= 0 && d.price <= 100000;
      }

      match /slots/{slotId} {
        allow read: if signedIn();
        allow create: if isUser(venueId)
          && validFreeSlot(incoming())
          && incoming().createdAt == request.time;
        // Booked by the owner (phone or walk-in), not through the app.
        function bookedOffline(d) {
          return d.status == 'booked' && d.get('booking', {}).get('offline', false) == true;
        }

        allow update: if isUser(venueId) && (
          // Edit a free slot.
          (resource.data.status == 'free'
            && changedKeys().hasOnly(['startAt', 'endAt', 'price'])
            && validFreeSlot(incoming()))
          ||
          // Mark a free slot booked (offline booking).
          (resource.data.status == 'free'
            && changedKeys().hasOnly(['status', 'booking'])
            && incoming().status == 'booked'
            && incoming().booking.keys().hasOnly(['offline', 'note', 'markedAt'])
            && incoming().booking.offline == true
            && incoming().booking.note is string
            && incoming().booking.note.size() <= 80
            && incoming().booking.markedAt == request.time)
          ||
          // Free an offline booking again. App bookings are cancelled via
          // the cancelVenueBooking function so the organizer is told.
          (bookedOffline(resource.data)
            && changedKeys().hasOnly(['status', 'booking'])
            && incoming().status == 'free'
            && !('booking' in incoming()))
        );
        allow delete: if isUser(venueId)
          && (resource.data.status == 'free' || bookedOffline(resource.data));
      }

      // ----- ratings: venues/{venueId}/ratings/{matchId}_{uid} -----
      // Players who were at a completed match there, within 14 days, once
      // per match. Averages are kept by onVenueRatingCreated.

      function score(n) {
        return n is int && n >= 1 && n <= 5;
      }

      match /ratings/{ratingId} {
        function ratedMatch() {
          return get(/databases/$(database)/documents/matches/$(incoming().matchId)).data;
        }

        function validRating() {
          let m = ratedMatch();
          let me = get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
          return incoming().keys().hasOnly(['matchId', 'reviewerId', 'overall', 'pitch',
                                            'facilities', 'value', 'comment', 'reviewer',
                                            'matchTitle', 'createdAt'])
            && incoming().reviewerId == request.auth.uid
            && ratingId == incoming().matchId + '_' + request.auth.uid
            && score(incoming().overall) && score(incoming().pitch)
            && score(incoming().facilities) && score(incoming().value)
            && incoming().comment is string && incoming().comment.size() <= 300
            && incoming().reviewer.keys().hasOnly(['name', 'photoUrl'])
            && incoming().reviewer.name == me.fullName
            && incoming().reviewer.photoUrl == me.photoUrl
            && m.venue.get('venueId', null) == venueId
            && m.status == 'completed'
            && request.time < m.endAt + duration.value(14, 'd')
            && incoming().matchTitle == m.title
            && (m.organizer.uid == request.auth.uid
                || exists(/databases/$(database)/documents/matches/$(incoming().matchId)/roster/$(request.auth.uid)))
            && incoming().createdAt == request.time;
        }

        allow read: if signedIn();
        allow create: if signedIn() && validRating();
        allow update, delete: if false;
      }
    }

    // ---------- match drafts (organizer-private) ----------

    match /match_drafts/{draftId} {
      allow read, delete: if signedIn()
        && resource.data.organizerId == request.auth.uid;

      allow create, update: if signedIn()
        && incoming().organizerId == request.auth.uid
        && (resource == null || resource.data.organizerId == request.auth.uid)
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().description is string && incoming().description.size() <= 2000
        && incoming().rules is string && incoming().rules.size() <= 2000
        && incoming().photos is list && incoming().photos.size() <= 5;
    }

    // ---------- users (private account data) ----------

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid)
        && incoming().keys().hasOnly(['email', 'createdAt', 'notificationPrefs'])
        && (!('email' in incoming()) || incoming().email == null
            || incoming().email == request.auth.token.email)
        && (!('notificationPrefs' in incoming()) || validPrefs(incoming().notificationPrefs));
      allow delete: if false;

      function validPrefs(p) {
        return p.keys().hasOnly(['requests', 'matches', 'chat', 'reviews'])
          && (!('requests' in p) || p.requests is bool)
          && (!('matches' in p) || p.matches is bool)
          && (!('chat' in p) || p.chat is bool)
          && (!('reviews' in p) || p.reviews is bool);
      }

      // Players I've blocked (doc ID = their uid).
      match /blocks/{blockedId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && blockedId != uid
          && incoming().keys().hasOnly(['name', 'createdAt'])
          && incoming().name is string && incoming().name.size() <= 60
          && incoming().createdAt == request.time;
        allow update: if false;
      }

      // FCM registration tokens (doc ID = token), managed by the app.
      match /devices/{token} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && token.size() <= 4096
          && incoming().keys().hasOnly(['platform', 'updatedAt'])
          && incoming().platform in ['android', 'ios', 'web']
          && incoming().updatedAt == request.time;
      }

      // Inbox: written only by Cloud Functions; the owner can mark read.
      match /notifications/{notificationId} {
        allow read: if isUser(uid);
        allow update: if isUser(uid)
          && changedKeys().hasOnly(['read'])
          && incoming().read == true;
        allow create, delete: if false;
      }
    }
  }
}

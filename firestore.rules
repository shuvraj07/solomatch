rules_version = '2';

// Security model: see docs/firestore-schema.md. Everything not matched below
// is denied. Every rule here has tests in functions/test/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return incoming().diff(resource.data).affectedKeys();
    }

    // ---------- players (public football profile) ----------

    function positions() {
      return ['goalkeeper', 'centerBack', 'fullBack', 'defensiveMidfielder',
              'centralMidfielder', 'attackingMidfielder', 'winger', 'striker'];
    }

    // Fields a player may write. `stats` is server-only; `username` is set
    // once at creation together with its `usernames/` claim.
    function editableProfileKeys() {
      return ['fullName', 'searchName', 'photoUrl', 'dateOfBirth', 'city',
              'bio', 'primaryPosition', 'secondaryPositions', 'skillLevel',
              'preferredFoot', 'heightCm', 'yearsPlaying', 'languages',
              'availability', 'updatedAt'];
    }

    function validProfile(d) {
      return d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 60
        && d.searchName == d.fullName.lower()
        && (d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 1024))
        // 16+ (5840 days; the app does the exact calendar check).
        && d.dateOfBirth is timestamp
        && d.dateOfBirth < request.time - duration.value(5840, 'd')
        && d.city is string && d.city.size() >= 1 && d.city.size() <= 60
        && d.bio is string && d.bio.size() <= 300
        && d.primaryPosition in positions()
        && d.secondaryPositions is list && d.secondaryPositions.size() <= 3
        && d.secondaryPositions.hasOnly(positions())
        && d.skillLevel in ['beginner', 'intermediate', 'advanced']
        && d.preferredFoot in ['right', 'left', 'both']
        && (d.heightCm == null || (d.heightCm is int && d.heightCm >= 120 && d.heightCm <= 230))
        && d.yearsPlaying is int && d.yearsPlaying >= 0 && d.yearsPlaying <= 60
        && d.languages is list && d.languages.size() <= 10
        && d.availability is list && d.availability.size() <= 21
        && d.updatedAt == request.time;
    }

    match /players/{uid} {
      allow read: if signedIn();

      allow create: if isUser(uid)
        && incoming().keys().hasOnly(editableProfileKeys().concat(['username', 'createdAt']))
        && validProfile(incoming())
        && incoming().createdAt == request.time
        // The username claim must be written in the same transaction.
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == uid;

      allow update: if isUser(uid)
        && changedKeys().hasOnly(editableProfileKeys())
        && validProfile(incoming());

      allow delete: if false;
    }

    // ---------- usernames (uniqueness index) ----------

    match /usernames/{username} {
      // `get` lets onboarding check availability; listing is not allowed.
      allow get: if signedIn();
      allow list: if false;

      // Only while creating your profile (so one username per player).
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid == request.auth.uid
        && !exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username == username;

      allow update, delete: if false;
    }

    // ---------- matches ----------

    function matchFormats() {
      return ['fiveASide', 'sevenASide', 'nineASide', 'elevenASide'];
    }

    function slotGroups() {
      return ['gk', 'def', 'mid', 'fwd', 'any'];
    }

    function openSlot(s, max) {
      return s.keys().hasOnly(['needed', 'filled'])
        && s.needed is int && s.needed >= 0 && s.needed <= max
        && s.filled == 0;
    }

    // New match: nothing filled, groups add up exactly to maxPlayers.
    function validNewSlots(s, max) {
      return s.keys().hasOnly(slotGroups()) && s.keys().hasAll(slotGroups())
        && openSlot(s.gk, max) && openSlot(s.def, max) && openSlot(s.mid, max)
        && openSlot(s.fwd, max) && openSlot(s.any, max)
        && s.gk.needed + s.def.needed + s.mid.needed + s.fwd.needed + s.any.needed == max;
    }

    function validVenue(v) {
      return v.keys().hasOnly(['name', 'address', 'city', 'placeId', 'lat', 'lng'])
        && v.name is string && v.name.size() >= 1 && v.name.size() <= 80
        && v.address is string && v.address.size() <= 120
        && v.city is string && v.city.size() >= 1 && v.city.size() <= 60
        && (v.placeId == null || v.placeId is string)
        && (v.lat == null || (v.lat is number && v.lat >= -90 && v.lat <= 90))
        && (v.lng == null || (v.lng is number && v.lng >= -180 && v.lng <= 180));
    }

    function validMatchText(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.searchTitle == d.title.lower()
        && d.description is string && d.description.size() <= 1000
        && d.rules is string && d.rules.size() <= 1000
        && d.photos is list && d.photos.size() <= 5;
    }

    function validPrice(p) {
      return p.keys().hasOnly(['amount', 'currency', 'isFree'])
        && p.amount is int && p.amount >= 0 && p.amount <= 100000
        && p.currency == 'NPR'
        && p.isFree == (p.amount == 0);
    }

    function isMatchOrganizer() {
      return signedIn() && resource.data.organizer.uid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      // Publishing. Counters start at zero; after this only the server
      // (Cloud Functions) changes roster counts and status, except cancel.
      allow create: if signedIn()
        && incoming().keys().hasOnly([
             'organizer', 'title', 'searchTitle', 'venue', 'startAt', 'endAt',
             'format', 'maxPlayers', 'currentPlayers', 'spotsRemaining', 'slots',
             'skillLevel', 'price', 'isIndoor', 'description', 'rules', 'photos',
             'status', 'createdAt', 'updatedAt'])
        && incoming().organizer.keys().hasOnly(['uid', 'name', 'username', 'photoUrl'])
        && incoming().organizer.uid == request.auth.uid
        && incoming().organizer.username
             == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.username
        && validMatchText(incoming())
        && validVenue(incoming().venue)
        && incoming().startAt is timestamp && incoming().startAt > request.time
        && incoming().endAt is timestamp
        && incoming().endAt >= incoming().startAt + duration.value(30, 'm')
        && incoming().endAt <= incoming().startAt + duration.value(6, 'h')
        && incoming().format in matchFormats()
        && incoming().maxPlayers is int
        && incoming().maxPlayers >= 2 && incoming().maxPlayers <= 30
        && incoming().currentPlayers == 0
        && incoming().spotsRemaining == incoming().maxPlayers
        && validNewSlots(incoming().slots, incoming().maxPlayers)
        && incoming().skillLevel in ['beginner', 'intermediate', 'advanced', 'any']
        && validPrice(incoming().price)
        && incoming().isIndoor is bool
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isMatchOrganizer()
        && incoming().updatedAt == request.time
        && (
          // Edit descriptive fields.
          (changedKeys().hasOnly(['title', 'searchTitle', 'description', 'rules',
                                  'photos', 'updatedAt'])
            && validMatchText(incoming()))
          ||
          // Cancel before kick-off.
          (changedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'cancelled'
            && resource.data.status in ['published', 'filling', 'full'])
        );

      allow delete: if false;

      function thisMatch() {
        return get(/databases/$(database)/documents/matches/$(matchId)).data;
      }

      // ----- join requests: matches/{matchId}/requests/{playerId} -----
      // Doc ID = player uid, so one request per player per match.
      // Accept / reject / leave happen only in Cloud Functions.

      function playerDoc() {
        return get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
      }

      // The player card organizers see must match the real profile.
      function validPlayerCard(p) {
        let profile = playerDoc();
        let stats = profile.get('stats', {});
        return p.keys().hasOnly(['uid', 'name', 'username', 'photoUrl',
                                 'primaryPosition', 'secondaryPositions',
                                 'skillLevel', 'ratingAvg', 'ratingCount',
                                 'gamesPlayed'])
          && p.uid == request.auth.uid
          && p.name == profile.fullName
          && p.username == profile.username
          && p.photoUrl == profile.photoUrl
          && p.primaryPosition == profile.primaryPosition
          && p.secondaryPositions == profile.secondaryPositions
          && p.skillLevel == profile.skillLevel
          && p.ratingAvg == stats.get('ratingAvg', 0)
          && p.ratingCount == stats.get('ratingCount', 0)
          && p.gamesPlayed == stats.get('gamesPlayed', 0);
      }

      function validNewRequest() {
        let m = thisMatch();
        return incoming().keys().hasOnly(['status', 'player', 'preferredGroup',
                                          'message', 'match', 'createdAt', 'updatedAt'])
          && incoming().status == 'pending'
          && validPlayerCard(incoming().player)
          && incoming().preferredGroup in slotGroups()
          && incoming().message is string && incoming().message.size() <= 200
          && incoming().match.keys().hasOnly(['title', 'startAt', 'venueName'])
          && incoming().match.title == m.title
          && incoming().match.startAt == m.startAt
          && incoming().match.venueName == m.venue.name
          && m.organizer.uid != request.auth.uid
          && m.status in ['published', 'filling']
          && m.startAt > request.time
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
      }

      match /requests/{playerId} {
        allow read: if isUser(playerId)
          || (signedIn() && thisMatch().organizer.uid == request.auth.uid);

        allow create: if isUser(playerId) && validNewRequest();

        allow update: if isUser(playerId) && (
          // Withdraw a pending request.
          (resource.data.status == 'pending'
            && changedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status == 'cancelled'
            && incoming().updatedAt == request.time)
          ||
          // Ask again after withdrawing or leaving. Rejection is final.
          (resource.data.status == 'cancelled' && validNewRequest())
        );

        allow delete: if false;
      }

      // ----- roster: matches/{matchId}/roster/{playerId} (server-only) -----

      match /roster/{playerId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // ----- Man of the Match: matches/{matchId}/motm_votes/{voterId} -----
      // One vote per voter (doc ID), changeable until voting closes. Voters
      // are roster players and the organizer; nominees are roster players,
      // never yourself. The server tallies when voting closes.

      function onRoster(uid) {
        return exists(/databases/$(database)/documents/matches/$(matchId)/roster/$(uid));
      }

      match /motm_votes/{voterId} {
        allow read: if isUser(voterId);

        allow create, update: if isUser(voterId)
          && incoming().keys().hasOnly(['nomineeId', 'votedAt'])
          && incoming().votedAt == request.time
          && incoming().nomineeId is string
          && incoming().nomineeId != request.auth.uid
          && onRoster(incoming().nomineeId)
          && (onRoster(request.auth.uid) || thisMatch().organizer.uid == request.auth.uid)
          && thisMatch().status == 'completed'
          && request.time < thisMatch().votingClosesAt;

        allow delete: if false;
      }
    }

    // ---------- "My matches": my requests across all matches ----------
    // Collection-group reads only return a player's own requests. The
    // query must filter on player.uid == my uid for this to pass.
    match /{path=**}/requests/{playerId} {
      allow read: if signedIn() && resource.data.player.uid == request.auth.uid;
    }

    // ---------- match drafts (organizer-private) ----------

    match /match_drafts/{draftId} {
      allow read, delete: if signedIn()
        && resource.data.organizerId == request.auth.uid;

      allow create, update: if signedIn()
        && incoming().organizerId == request.auth.uid
        && (resource == null || resource.data.organizerId == request.auth.uid)
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().description is string && incoming().description.size() <= 2000
        && incoming().rules is string && incoming().rules.size() <= 2000
        && incoming().photos is list && incoming().photos.size() <= 5;
    }

    // ---------- users (private account data) ----------

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid)
        && incoming().keys().hasOnly(['email', 'createdAt'])
        && (incoming().email == null || incoming().email == request.auth.token.email);
      allow delete: if false;
    }
  }
}
